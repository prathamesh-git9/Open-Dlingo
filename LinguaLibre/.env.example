# Paste your xAI (Grok) API key here — get one at https://console.x.ai
# The app never limits usage: unlimited AI tutor, explanations and practice generation.
XAI_API_KEY=xai-YOUR-KEY-HERE

# Optional: which Grok model to use (default: grok-2-latest)
XAI_MODEL=grok-2-latest

# Optional: server port (default 3000)
PORT=3000
